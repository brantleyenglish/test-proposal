# Optional: Azure OpenAI for AI-assisted triage recommendations.
# Leave these empty to use the built-in rules engine (the demo works fully offline).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# API port (the Vite dev server proxies /api to it)
PORT=3001
